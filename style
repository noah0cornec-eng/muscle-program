:root{
  --bg:#0f1419;--card:#18202a;--card2:#1f2935;--text:#e8eef5;--muted:#8fa0b3;
  --accent:#3ddc97;--accent2:#4da3ff;--warn:#ffb84d;--danger:#ff6b6b;--border:#2a3644;
}
@media (prefers-color-scheme: light){
  :root{--bg:#f4f6f9;--card:#fff;--card2:#eef2f6;--text:#18212b;--muted:#5d6b7a;--border:#d8dfe7;--accent:#0f9d6a;--accent2:#1a6fd1}
}
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.45}
.top{position:sticky;top:0;z-index:10;background:var(--bg);border-bottom:1px solid var(--border);padding:.6rem 1rem}
.top h1{margin:0 0 .4rem;font-size:1.2rem}
nav{display:flex;gap:.4rem;overflow-x:auto;padding-bottom:.2rem}
nav button{flex:0 0 auto;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:999px;padding:.4rem .9rem;font-size:.9rem;cursor:pointer}
nav button.active{background:var(--accent);color:#06281a;border-color:var(--accent);font-weight:600}
main{max-width:980px;margin:0 auto;padding:1rem}
footer{max-width:980px;margin:0 auto;padding:1rem;color:var(--muted);font-size:.8rem}
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1rem;margin-bottom:1rem}
.card h2{margin:.1rem 0 .6rem;font-size:1.1rem}
.card h3{margin:.8rem 0 .4rem;font-size:1rem}
.grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.form{display:grid;gap:.7rem;grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
label{display:flex;flex-direction:column;font-size:.8rem;color:var(--muted);gap:.2rem}
input,select,textarea{background:var(--card2);color:var(--text);border:1px solid var(--border);border-radius:8px;padding:.5rem;font-size:.95rem;width:100%;font-family:inherit}
input[type=number]{min-width:0}
button{font-family:inherit}
button.primary,button.secondary,button.danger,button.small{border-radius:8px;border:1px solid var(--border);padding:.5rem .9rem;cursor:pointer;font-size:.9rem}
button.primary{background:var(--accent);color:#06281a;border-color:var(--accent);font-weight:600}
button.secondary{background:var(--card2);color:var(--text)}
button.danger{background:transparent;color:var(--danger);border-color:var(--danger)}
button.small{padding:.25rem .6rem;font-size:.8rem;background:var(--card2);color:var(--text)}
.row{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin:.4rem 0}
.row>*{flex:0 1 auto}
.row input,.row select{width:auto;min-width:70px}
.muted{color:var(--muted);font-size:.85rem}
.hidden{display:none!important}
.stat{display:flex;justify-content:space-between;padding:.25rem 0;border-bottom:1px dashed var(--border);font-size:.92rem}
.stat b{color:var(--accent)}
.bar{background:var(--card2);border-radius:999px;height:10px;overflow:hidden;margin:.15rem 0 .6rem}
.bar i{display:block;height:100%;background:var(--accent2)}
.bar i.ok{background:var(--accent)}
.bar i.over{background:var(--warn)}
table{width:100%;border-collapse:collapse;font-size:.85rem}
th,td{padding:.35rem .4rem;border-bottom:1px solid var(--border);text-align:left}
th{color:var(--muted);font-weight:600}
td input{padding:.3rem;width:100%}
.scroll{overflow-x:auto}
.chips{display:flex;flex-wrap:wrap;gap:.4rem;margin:.3rem 0 .8rem}
.chip{background:var(--card2);border:1px solid var(--border);color:var(--text);padding:.3rem .7rem;border-radius:999px;font-size:.82rem;cursor:pointer}
.chip.active{background:var(--accent2);color:#fff;border-color:var(--accent2)}
.badge{display:inline-block;font-size:.72rem;padding:.1rem .5rem;border-radius:999px;background:var(--card2);border:1px solid var(--border);margin-right:.3rem}
.badge.t1{border-color:var(--accent);color:var(--accent)}
.badge.t2{border-color:var(--accent2);color:var(--accent2)}
.rec{border-left:4px solid var(--accent2)}
.rec.established{border-left-color:var(--accent)}
.rec.promising{border-left-color:var(--warn)}
.paper{padding:.6rem 0;border-bottom:1px solid var(--border)}
.paper a{color:var(--accent2);text-decoration:none;font-weight:600}
.paper pre{white-space:pre-wrap;font-family:inherit;font-size:.85rem;background:var(--card2);padding:.6rem;border-radius:8px}
svg.chart{width:100%;height:auto}
svg .grid{stroke:var(--border);stroke-width:1}
svg .axis{fill:var(--muted);font-size:10px}
.legend{display:flex;gap:.8rem;flex-wrap:wrap;font-size:.8rem;color:var(--muted)}
.legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:.3rem}
.weeks{display:flex;gap:.3rem;flex-wrap:wrap;margin:.4rem 0}
.weeks button{min-width:2.3rem}
.weeks button.active{background:var(--accent);color:#06281a;border-color:var(--accent)}
.weeks button.deload{border-style:dashed}
.ex{background:var(--card2)}
.photos{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:.5rem}
.photos img{width:100%;border-radius:8px;display:block}
.timer{position:fixed;bottom:1rem;left:50%;transform:translateX(-50%);background:var(--accent);color:#06281a;padding:.6rem 1.2rem;border-radius:999px;font-weight:700;z-index:20;box-shadow:0 4px 18px rgba(0,0,0,.4);cursor:pointer}
a{color:var(--accent2)}
